<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".ui.groups.GroupsFragment">

    <!-- Guideline para el banner -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.03"
        android:orientation="horizontal"/>

    <!-- Banner AdMob arriba -->
    <com.google.android.gms.ads.AdView
        android:id="@+id/adViewGroups"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:adSize="BANNER"
        app:adUnitId="ca-app-pub-7467173777372011/4567587890"
        app:layout_constraintTop_toBottomOf="@id/guideline_banner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/buttonsContainer"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        app:layout_constraintTop_toBottomOf="@id/adViewGroups"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center">


        <Button
            android:id="@+id/btnCreateGroup"
            style="@style/TextAppearance.App.SubtitleMedium"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="0dp"
            android:backgroundTint="@color/green_500"
            android:text="CREAR GRUPO"
            android:textSize="20sp"
            android:textAllCaps="true"
            android:textColor="@android:color/white"
            app:cornerRadius="24dp"/>

        <Button
            android:id="@+id/btnViewAllGroups"
            style="@style/TextAppearance.App.SubtitleMedium"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="40dp"
            android:backgroundTint="@color/green_500"
            android:text="VER GRUPOS"
            android:textSize="20sp"
            android:textAllCaps="true"
            android:textColor="@android:color/white"
            app:cornerRadius="24dp"/>

        <Button
            android:id="@+id/btnJoinGroup"
            style="@style/TextAppearance.App.SubtitleMedium"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="40dp"
            android:backgroundTint="@color/green_500"
            android:text="UNIRSE A GRUPO"
            android:textSize="20sp"
            android:textAllCaps="true"
            android:textColor="@android:color/white"
            app:cornerRadius="24dp"/>

    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>